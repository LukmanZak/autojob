# === Scraper ===
HEADLESS=true
# Opsional: override chrome playwright (kosongkan untuk pakai default)
# PLAYWRIGHT_CHROME_PATH=C:/Users/xxx/AppData/Local/ms-playwright/chromium-xxxx/chrome-win/chrome.exe

# === Kredensial Auto-Apply (isi jika mau auto-lamar) ===
DISNAKERJA_USER=
DISNAKERJA_PASS=
GLINTS_USER=
GLINTS_PASS=
JOBSTREET_USER=
JOBSTREET_PASS=

# === Auto-Apply ===
APPLY_MODE=dry-run
APPLY_LIMIT=3
